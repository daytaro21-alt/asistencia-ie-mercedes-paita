# ==========================================
# CONFIGURACIÓN DEL SERVIDOR Y ZONA HORARIA
# ==========================================
PORT=3000
NODE_ENV=production
TZ=America/Lima
HORA_INICIO_INGRESO=12:30:00
HORA_LIMITE_PUNTUAL=12:45:00
HORA_CIERRE_PORTON=13:30:00
FRONTEND_URL=*

# ==========================================
# BASE DE DATOS MYSQL (Local / Cloud RDS / Railway / Aiven)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin_mercedes
DB_PASSWORD=tu_password_seguro
DB_NAME=asistencia_mercedes
DB_SSL=false

# ==========================================
# SEGURIDAD JWT (Panel TOECE)
# ==========================================
JWT_SECRET=reemplazar_por_secreto_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=8h

# ==========================================
# INTELIGENCIA ARTIFICIAL (Google Gemini)
# ==========================================
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# ==========================================
# SERVICIO DE WHATSAPP (whatsapp-web.js)
# ==========================================
ENABLE_WHATSAPP=true
# Pausa de seguridad anti-bloqueo entre mensaje y mensaje (en segundos):
WHATSAPP_SEGUNDOS_ENTRE_MENSAJES=20

# ==========================================
# MODO SIMULACIÓN Y CAPACITACIÓN (Pruebas fuera de horario)
# ==========================================
# Si es true: no bloquea el portón a la 1:30 PM y silencia envíos reales de WhatsApp
MODO_SIMULACION=false
DESACTIVAR_CIERRE_AUTO=false
